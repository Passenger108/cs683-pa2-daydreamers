#include "cache.h"

// ===========================================================================
//  CS683 PA2 - Task 1B
//  SPP : Stride Pattern Prefetcher at the L1D, trained per instruction (IP)
// ===========================================================================
//
//  WHY TWO PREDICTORS?
//  -------------------
//  The IP-stride prefetcher of Task 1A can only say "this IP always moves by
//  the same number of cache lines".  It therefore dies on a loop like
//
//        for (i = 0; i < n; i++) { ... a[i].x ... a[i].y ... }
//
//  whose stride stream is a repeating *sequence* such as (+1,+2,+2,+2,+3)^n.
//  SPP keeps two predictors that share ONE training stream:
//
//    (1) UNIFORM     : "last_stride keeps repeating"   -> addr + k*stride
//    (2) NON-UNIFORM : "a short sequence of strides repeats".  The sequence is
//                      compressed into a SIGNATURE (a rolling hash of the last
//                      few strides) and a Pattern Table maps
//                            signature  ->  next expected stride.
//
//  The assignment requires UNIFORM to have priority and a dynamic fall-back to
//  NON-UNIFORM the moment the constant stride breaks.  That is what the 2-bit
//  `uniform_conf` counter does.
//
//  WHY A SIGNATURE AND NOT A LIST OF STRIDES?
//  ------------------------------------------
//  Keeping the last k strides per IP and searching for the period costs k*7
//  bits per IP plus a comparator tree.  A signature costs 10 bits per IP and
//  ONE table lookup, and it is what the assignment explicitly asks for:
//  "maintain a signature that represents the sequence of recently observed
//  strides; this signature should map to the next expected stride."
//
//  WHY DOES DEGREE > 1 NEED A LOOKAHEAD CHAIN?
//  -------------------------------------------
//  For a uniform stride you can jump ahead by multiplying: addr + 2*stride.
//  For a non-uniform pattern that is simply wrong, because the second stride is
//  a different number.  The only way to go deeper is to replay the predictor on
//  its own output:
//        sig -> d1 ;  sig' = update(sig,d1) -> d2 ;  sig'' -> d3 ; ...
//  and prefetch addr+d1, addr+d1+d2, addr+d1+d2+d3.  Both paths are therefore
//  written as ONE loop below; they differ only in where `next_stride` comes
//  from.  This is also why the chain must stop as soon as a predicted stride is
//  not confident: every later address in the chain is built on top of it.
//
//  PAGE CONFINEMENT (hard requirement)
//  -----------------------------------
//  Rather than build a full address and then test its page, we work in units of
//  "cache-line offset inside the 4 KB page" (0..63).  A prefetch is only built
//  when its offset is still within 0..63, so leaving the page is structurally
//  impossible.  A pleasant side effect: every usable stride is bounded by
//  +/-63 lines, which is exactly why a 7-bit signed stride field is the right
//  width - no truncation is ever possible.
// ===========================================================================


// ------------------------------- sizing ------------------------------------
// IP table: set associative with LRU, like the tracker array of ip_stride but
// indexed instead of linearly searched.  A purely direct-mapped table was tried
// first and thrashed badly - it re-allocated an entry on ~73% of all loads,
// which destroys a stride history before it can ever be used.
#define IP_TABLE_SETS         64
#define IP_TABLE_WAYS         4
#define IP_TABLE_ENTRIES      (IP_TABLE_SETS * IP_TABLE_WAYS)
#define IP_INDEX(ip)          ((uint32_t)((ip) & (IP_TABLE_SETS - 1)))
#define IP_TAG(ip)            ((uint16_t)(((ip) >> 6) & 0xFFFF))

#define SIG_BITS              10      // 10-bit signature
#define PATTERN_ENTRIES       (1 << SIG_BITS)
#define SIG_MASK              (PATTERN_ENTRIES - 1)
#define SIG_SHIFT             3       // keeps ~4 strides of history in 10 bits

#define PAGE_TAG_MASK         0xFFF   // 12-bit page tag, only to spot a page change
#define LINES_PER_PAGE        (PAGE_SIZE / BLOCK_SIZE)   // 4096/64 = 64

// A stride must repeat UNIFORM_CONF_MAX times IN A ROW before the uniform path
// is trusted.  3 is not arbitrary: the longest run of identical strides in the
// assignment's own example (+1,+2,+2,+2,+3) is three 2's, which produces only
// TWO consecutive "stride == last_stride" events.  A threshold of 3 is
// therefore the smallest value that provably never mistakes that pattern for a
// uniform stream.
#define UNIFORM_CONF_MAX      3

#define PATTERN_CONF_MAX      3       // 2-bit saturating confidence
#define PATTERN_CONF_PREDICT  2       // predict only when conf >= 2

// Accuracy based throttling.
#define MAX_DEGREE            4
#define MIN_DEGREE            1
#define ACC_WINDOW            512     // re-evaluate every 512 lines actually fetched


// --------------------------- the two tables --------------------------------

// One entry per tracked load instruction.
class IP_ENTRY {
  public:
    uint16_t tag;            // 16 b : which IP owns this entry
    uint8_t  valid;          //  1 b
    uint16_t last_page;      // 12 b : page tag, only used to detect a page change
    uint8_t  last_offset;    //  6 b : line offset of the last access in that page
    int8_t   last_stride;    //  7 b : signed, -63..+63 lines
    uint8_t  uniform_conf;   //  2 b : how many times last_stride repeated
    uint16_t signature;      // 10 b : rolling hash of the recent stride sequence
    uint8_t  lru;            //  2 b : 0 = most recently used within the set

    IP_ENTRY() {
        tag = 0; valid = 0; last_page = 0; last_offset = 0;
        last_stride = 0; uniform_conf = 0; signature = 0; lru = 0;
    };
};

// signature -> next expected stride.  Direct mapped and tagless: a signature
// collision simply shows up as a low-confidence entry, which we then refuse to
// predict from, so a tag would cost storage to prevent something the
// confidence counter already handles.
class PATTERN_ENTRY {
  public:
    int8_t  stride;          // 7 b signed
    uint8_t conf;            // 2 b saturating

    PATTERN_ENTRY() { stride = 0; conf = 0; };
};

IP_ENTRY      ip_table[IP_TABLE_SETS][IP_TABLE_WAYS];
PATTERN_ENTRY pattern_table[PATTERN_ENTRIES];

// ------------------------- throttling state --------------------------------
int      spp_degree    = MAX_DEGREE;  // 3 b, current aggressiveness
uint64_t acc_last_pull = 0;           // window snapshots (12 b each in hardware)
uint64_t acc_last_good = 0;

// ------------------- simulation-only statistics ----------------------------
// (NOT part of the hardware budget; they only feed the report)
uint64_t spp_pf_uniform  = 0;
uint64_t spp_pf_nonunif  = 0;
uint64_t spp_windows[MAX_DEGREE + 1] = {0};
uint64_t spp_acc_sum     = 0;
uint64_t spp_acc_windows = 0;
uint64_t spp_ip_allocs   = 0;
uint64_t spp_ip_hits     = 0;
uint64_t spp_page_breaks = 0;
uint64_t spp_chain_stops = 0;


// Roll one stride into the signature.  Shifting left by 3 and XOR-ing in the
// low 7 bits of the stride keeps roughly the last four strides alive inside 10
// bits - enough to tell apart every phase of a period-5 sequence, which is what
// the assignment's example needs.
uint16_t spp_update_signature(uint16_t sig, int stride)
{
    return (uint16_t)(((sig << SIG_SHIFT) ^ (stride & 0x7F)) & SIG_MASK);
}

// Train one Pattern Table entry.  `sig` was the signature BEFORE we saw
// `stride`, so `stride` is the ground truth this signature should have
// predicted.  A wrong prediction only DECREMENTS confidence; the stored stride
// is replaced only once the entry is completely discredited (conf == 0).  That
// way a single odd access cannot wipe out a pattern learned over thousands of
// iterations, while a genuine phase change still flips the entry after a few
// mispredictions.
void spp_train_pattern(uint16_t sig, int stride)
{
    PATTERN_ENTRY &p = pattern_table[sig];

    if (p.conf > 0 && p.stride == stride) {
        if (p.conf < PATTERN_CONF_MAX) p.conf++;
    } else if (p.conf == 0) {
        p.stride = (int8_t)stride;
        p.conf   = 1;
    } else {
        p.conf--;
    }
}


void CACHE::l1d_prefetcher_initialize()
{
    cout << "------------------------------------------------" << endl;
    cout << "        Stride Pattern Prefetcher (SPP)         " << endl;
    cout << "------------------------------------------------" << endl;
    cout << "IP table              : " << IP_TABLE_SETS << " sets x "
         << IP_TABLE_WAYS << " ways = " << IP_TABLE_ENTRIES << " entries" << endl;
    cout << "Pattern table         : " << PATTERN_ENTRIES << " entries ("
         << SIG_BITS << "-bit signature)" << endl;
    cout << "Degree                : " << MIN_DEGREE << " .. " << MAX_DEGREE
         << " (accuracy throttled, window = " << ACC_WINDOW << ")" << endl;

    for (int s = 0; s < IP_TABLE_SETS; s++)
        for (int w = 0; w < IP_TABLE_WAYS; w++)
            ip_table[s][w].lru = w;
}


void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    // ---------------------------------------------------------------- (0)
    // Only demand loads train and trigger SPP.
    // This matters more than it looks: ChampSim also calls this function from
    // the prefetch queue with type == PREFETCH, i.e. with the addresses WE just
    // generated.  Learning from our own predictions would feed the prefetcher
    // its own output and destroy the real stride stream.
    // Cache HITS are deliberately kept in the training stream (cache_hit is
    // ignored): the stride sequence of an instruction exists whether or not the
    // data happened to be resident, and dropping hits would corrupt it.
    if (type != LOAD)
        return;

    // ---------------------------------------------------------------- (1)
    // ACCURACY CHECKER / THROTTLE.
    //
    // Denominator = pf_lower_level = prefetches that actually MISSED and
    // allocated an MSHR entry, i.e. lines we really pulled into the cache.
    // This is the right denominator, and getting it wrong is easy: counting
    // every prefetch we *requested* buries the signal, because most requests
    // hit in the L1D and are dropped before costing any bandwidth or evicting
    // anything.  A prefetch that is dropped cannot pollute, so it must not
    // appear in an anti-pollution metric.  It is also exactly the ratio
    // ChampSim prints as "ACCURACY", so our internal view and the reported
    // number agree.
    //
    // Numerator = demand hits on lines we prefetched, PLUS prefetches that a
    // demand caught while still in flight ("late").  Late prefetches are
    // counted as useful on purpose: their ADDRESS was right, so they polluted
    // nothing.  Throttling because of them would be exactly backwards - fewer
    // prefetches would only make them later.
    if (pf_lower_level - acc_last_pull >= ACC_WINDOW) {
        uint64_t pulled = pf_lower_level - acc_last_pull;

        // signed, because ChampSim zeroes these counters when the ROI begins
        int64_t good = (int64_t)(pf_useful + late_prefetch) - (int64_t)acc_last_good;
        if (good < 0) good = 0;

        int acc = (int)((good * 100) / (int64_t)pulled);
        if (acc > 100) acc = 100;

        if      (acc >= 75) spp_degree = 4;
        else if (acc >= 50) spp_degree = 3;
        else if (acc >= 25) spp_degree = 2;
        else                spp_degree = MIN_DEGREE;   // never 0: see report

        acc_last_pull = pf_lower_level;
        acc_last_good = pf_useful + late_prefetch;

        spp_windows[spp_degree]++;
        spp_acc_sum += acc;
        spp_acc_windows++;
    }

    // ---------------------------------------------------------------- (2)
    // Split the address into (page tag, line offset inside the page).
    uint16_t page   = (uint16_t)((addr >> LOG2_PAGE_SIZE) & PAGE_TAG_MASK);
    int      offset = (int)((addr >> LOG2_BLOCK_SIZE) & (LINES_PER_PAGE - 1));

    // ---------------------------------------------------------------- (3)
    // IP table lookup: index with the low bits of the PC, then search the ways.
    uint32_t set = IP_INDEX(ip);
    uint16_t tag = IP_TAG(ip);

    int way = -1;
    for (int w = 0; w < IP_TABLE_WAYS; w++) {
        if (ip_table[set][w].valid && ip_table[set][w].tag == tag) {
            way = w;
            break;
        }
    }

    if (way < 0) {
        // miss: take the LRU way and start a fresh history for this IP
        for (int w = 0; w < IP_TABLE_WAYS; w++)
            if (ip_table[set][w].lru == (IP_TABLE_WAYS - 1)) way = w;

        IP_ENTRY &n = ip_table[set][way];
        n.valid        = 1;
        n.tag          = tag;
        n.last_page    = page;
        n.last_offset  = (uint8_t)offset;
        n.last_stride  = 0;
        n.uniform_conf = 0;
        n.signature    = 0;
        spp_ip_allocs++;

        for (int w = 0; w < IP_TABLE_WAYS; w++)
            if (ip_table[set][w].lru < ip_table[set][way].lru) ip_table[set][w].lru++;
        ip_table[set][way].lru = 0;
        return;
    }

    spp_ip_hits++;
    IP_ENTRY &e = ip_table[set][way];

    // this IP is being used, so make it most-recently-used in its set
    for (int w = 0; w < IP_TABLE_WAYS; w++)
        if (ip_table[set][w].lru < e.lru) ip_table[set][w].lru++;
    e.lru = 0;

    if (e.last_page != page) {
        // The step that crossed the page is not representable in 6 bits, and we
        // are not allowed to prefetch across it anyway.  Re-anchor the entry but
        // KEEP last_stride / uniform_conf / signature, so a long streaming load
        // does not have to re-learn itself at every page boundary.
        e.last_page   = page;
        e.last_offset = (uint8_t)offset;
        spp_page_breaks++;
        return;
    }

    int stride = offset - (int)e.last_offset;
    e.last_page   = page;
    e.last_offset = (uint8_t)offset;

    if (stride == 0)
        return;                      // same line twice: nothing to learn

    // ---------------------------------------------------------------- (4)
    // TRAIN BOTH PREDICTORS, ALWAYS.
    // The pattern table is trained even while the uniform path is driving.
    // Otherwise every uniform -> non-uniform transition would start from a cold
    // table and we would mispredict for hundreds of accesses after each phase
    // change - the opposite of "adapt quickly to the region".
    spp_train_pattern(e.signature, stride);
    e.signature = spp_update_signature(e.signature, stride);

    if (stride == e.last_stride) {
        if (e.uniform_conf < UNIFORM_CONF_MAX) e.uniform_conf++;
    } else {
        e.uniform_conf = 0;          // hard reset == fall back immediately
    }
    e.last_stride = (int8_t)stride;

    // ---------------------------------------------------------------- (5)
    // PREDICT.  Uniform has priority; otherwise follow the signature chain.
    uint8_t  uniform = (e.uniform_conf == UNIFORM_CONF_MAX) ? 1 : 0;
    uint16_t sig     = e.signature;
    int      cum     = 0;            // cumulative lines ahead of `offset`

    for (int i = 0; i < spp_degree; i++) {

        int next_stride;

        if (uniform) {
            next_stride = e.last_stride;          // same step every time
        } else {
            PATTERN_ENTRY &p = pattern_table[sig];
            if (p.conf < PATTERN_CONF_PREDICT) { spp_chain_stops++; break; }
            next_stride = p.stride;
            if (next_stride == 0) { spp_chain_stops++; break; }
            sig = spp_update_signature(sig, next_stride);   // speculative step
        }

        cum += next_stride;
        int pf_offset = offset + cum;

        // page confinement, by construction
        if (pf_offset < 0 || pf_offset >= LINES_PER_PAGE)
            break;

        uint64_t pf_addr = (addr & ~((uint64_t)PAGE_SIZE - 1))
                         | ((uint64_t)pf_offset << LOG2_BLOCK_SIZE);

        // Same L1/L2 split as ip_stride: when the L1D MSHRs are already half
        // full, demand misses matter more than our guesses, so the prefetch is
        // dropped one level down instead of competing for L1D MSHRs.
        if (MSHR.occupancy < (MSHR.SIZE >> 1))
            prefetch_line(ip, addr, pf_addr, FILL_L1, 0);
        else
            prefetch_line(ip, addr, pf_addr, FILL_L2, 0);

        if (uniform) spp_pf_uniform++; else spp_pf_nonunif++;
    }
}


void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    // SPP learns only from the demand stream, so there is nothing to do here.
    return;
}


void CACHE::l1d_prefetcher_final_stats()
{
    uint64_t total   = spp_pf_uniform + spp_pf_nonunif;
    uint64_t lookups = spp_ip_hits + spp_ip_allocs;

    cout << endl;
    cout << "=========== SPP (L1D) final stats ===========" << endl;
    cout << "SPP prefetches from UNIFORM path     : " << spp_pf_uniform;
    if (total) cout << "  (" << (100.0 * spp_pf_uniform / total) << "%)";
    cout << endl;
    cout << "SPP prefetches from NON-UNIFORM path : " << spp_pf_nonunif;
    if (total) cout << "  (" << (100.0 * spp_pf_nonunif / total) << "%)";
    cout << endl;

    cout << "SPP mean windowed usefulness         : "
         << (spp_acc_windows ? (1.0 * spp_acc_sum / spp_acc_windows) : 0.0)
         << " %  over " << spp_acc_windows << " windows" << endl;

    cout << "SPP windows spent at degree          :";
    for (int d = MIN_DEGREE; d <= MAX_DEGREE; d++)
        cout << "  d" << d << "=" << spp_windows[d];
    cout << endl;

    uint64_t used = 0;
    for (int i = 0; i < PATTERN_ENTRIES; i++)
        if (pattern_table[i].conf >= PATTERN_CONF_PREDICT) used++;
    cout << "SPP pattern-table entries conf>=" << PATTERN_CONF_PREDICT
         << "    : " << used << " / " << PATTERN_ENTRIES << endl;

    cout << "SPP IP-table hit rate                : "
         << (lookups ? (100.0 * spp_ip_hits / lookups) : 0.0)
         << " %  (" << spp_ip_allocs << " allocations)" << endl;
    cout << "SPP page-boundary re-anchors         : " << spp_page_breaks << endl;
    cout << "SPP lookahead chains cut by conf     : " << spp_chain_stops << endl;
    cout << "=============================================" << endl;
}
