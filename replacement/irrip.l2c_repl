#include "cache.h"

/*  I-RRIP -- instruction-conscious RRIP for the L2                PA2 Task 2a
 *
 *  Behaviourally this is replacement/rrip.l2c_repl (SRRIP) with the insertion
 *  and promotion values made type-aware. The whole policy is:
 *
 *      an instruction line gets one aging round of protection;
 *      a data line never rises above evict-next.
 *
 *  Why that is the right shape, why eviction is left alone, the 26-variant
 *  sweep that chose these values, and the three predictions it refuted are all
 *  in docs/TASK2A_DESIGN_DECISIONS.md -- deliberately there and not here, so
 *  this file stays short enough to read in one sitting.
 *
 *  The one number worth carrying while reading the code: in this L2 a data
 *  line is re-referenced 0.13 times per fill, an instruction line 0.54-3.06
 *  times. The policy is not a preference for instructions; it is those two
 *  reuse rates, encoded.                                     (design doc 14.2)
 */

/* ------------------------------- knobs ---------------------------------- *
 * scripts/sweep_task2a.py rewrites exactly these lines and nothing else.
 * The #ifndef wrappers also allow -DIRRIP_X=n from the compiler.           */

/* Top of the RRPV range; an n-bit RRPV gives 2^n - 1. Shipped at 1 (one bit,
 * 1 KB) because the sweep found nothing for wider states to express when
 * there are only two classes to separate. 0 is excluded: insertion and
 * evict-now would be the same value, leaving no priority to express. */
#ifndef IRRIP_MAX_RRPV
#define IRRIP_MAX_RRPV 1
#endif

/* Insertion = a protection budget in aging rounds: a line at r survives
 * (IRRIP_MAX_RRPV - r) aging passes before it can be chosen as victim. */
#ifndef IRRIP_INSERT_INSTR
#define IRRIP_INSERT_INSTR 0
#endif
/* Written as IRRIP_MAX_RRPV, not (IRRIP_MAX_RRPV - 1): at max == 1 that
 * expression is 0, which would silently equal the instruction value and leave
 * no bias at all. */
#ifndef IRRIP_INSERT_DATA
#define IRRIP_INSERT_DATA IRRIP_MAX_RRPV
#endif
#ifndef IRRIP_INSERT_TRANSL
#define IRRIP_INSERT_TRANSL IRRIP_MAX_RRPV
#endif

/* Promotion = the RRPV written when a resident line is hit. 0 is SRRIP's
 * answer. Data is weakened to the edge: at 0.13 hits per fill an L2 data hit
 * means "referenced twice", not "hot", so the hit is honoured by the line
 * surviving this eviction and nothing more. I argued the opposite before
 * measuring and was wrong (design doc 14.3). */
#ifndef IRRIP_PROMOTE_INSTR
#define IRRIP_PROMOTE_INSTR 0
#endif
#ifndef IRRIP_PROMOTE_DATA
#define IRRIP_PROMOTE_DATA IRRIP_MAX_RRPV
#endif
#ifndef IRRIP_PROMOTE_TRANSL
#define IRRIP_PROMOTE_TRANSL 0
#endif

/* Eviction: off by default, so the victim scan is a pure function of the RRPV
 * and the RRPV stays the complete summary of a line's priority. When on, the
 * scan passes over an instruction line if some non-instruction line is within
 * SLACK of the edge -- xPTP's bounded diversion rather than an absolute veto. */
#ifndef IRRIP_EVICT_PREFER_DATA
#define IRRIP_EVICT_PREFER_DATA 0
#endif
#ifndef IRRIP_EVICT_SLACK
#define IRRIP_EVICT_SLACK 0
#endif

/* Does a writeback hit promote? Held at rrip.l2c_repl's answer (yes) so that
 * "I-RRIP minus RRIP" isolates instruction-consciousness and nothing else. */
#ifndef IRRIP_WB_PROMOTES
#define IRRIP_WB_PROMOTES 1
#endif

/* Reject a nonsensical sweep value at compile time rather than let it produce
 * a number that looks like a result. SLACK must stay below MAX_RRPV or the
 * preference pass matches every way in the set. */
static_assert(IRRIP_MAX_RRPV >= 1 && IRRIP_MAX_RRPV <= 7, "IRRIP_MAX_RRPV must be 1..7");
static_assert(IRRIP_INSERT_INSTR  >= 0 && IRRIP_INSERT_INSTR  <= IRRIP_MAX_RRPV &&
              IRRIP_INSERT_DATA   >= 0 && IRRIP_INSERT_DATA   <= IRRIP_MAX_RRPV &&
              IRRIP_INSERT_TRANSL >= 0 && IRRIP_INSERT_TRANSL <= IRRIP_MAX_RRPV,
              "an IRRIP_INSERT_* value is outside 0..IRRIP_MAX_RRPV");
static_assert(IRRIP_PROMOTE_INSTR  >= 0 && IRRIP_PROMOTE_INSTR  <= IRRIP_MAX_RRPV &&
              IRRIP_PROMOTE_DATA   >= 0 && IRRIP_PROMOTE_DATA   <= IRRIP_MAX_RRPV &&
              IRRIP_PROMOTE_TRANSL >= 0 && IRRIP_PROMOTE_TRANSL <= IRRIP_MAX_RRPV,
              "an IRRIP_PROMOTE_* value is outside 0..IRRIP_MAX_RRPV");
static_assert(IRRIP_EVICT_SLACK >= 0 && IRRIP_EVICT_SLACK < IRRIP_MAX_RRPV,
              "IRRIP_EVICT_SLACK must be 0..IRRIP_MAX_RRPV-1");
static_assert((IRRIP_WB_PROMOTES == 0 || IRRIP_WB_PROMOTES == 1) &&
              (IRRIP_EVICT_PREFER_DATA == 0 || IRRIP_EVICT_PREFER_DATA == 1),
              "IRRIP_WB_PROMOTES and IRRIP_EVICT_PREFER_DATA are 0 or 1");

/* ------------------------------- state ---------------------------------- */

uint8_t  l2_irrip_rrpv[L2C_SET][L2C_WAY];   /* the only per-line state      */
uint64_t irrip_insert[3], irrip_promote[3]; /* stats only; never a decision */
uint64_t irrip_wb_skipped, irrip_evict_pref, irrip_age_rounds;

#define IRRIP_TRANSL 0
#define IRRIP_INSTR  1
#define IRRIP_DATA   2

/* Translations are tested FIRST: an instruction page walk arrives with
 * packet.instruction == 1 but is not an instruction line -- it is page-table
 * data on the way to one, and fill_cache() agrees (block.translation, not
 * block.instruction). The three classes are byte-for-byte those of
 * fill_packet_type in src/cache.cc:60, so they line up 1:1 with the nine
 * "<X> Evicting <Y>" counters the simulator already prints. */
static inline int irrip_class(uint32_t type, uint8_t isInstruction)
{
    if (type == LOAD_TRANSLATION || type == PREFETCH_TRANSLATION || type == TRANSLATION_FROM_L1D)
        return IRRIP_TRANSL;
    if ((type == LOAD || type == PREFETCH) && isInstruction)
        return IRRIP_INSTR;
    return IRRIP_DATA;
}

static inline uint8_t irrip_insert_rrpv(int cls)
{
    if (cls == IRRIP_INSTR)  return IRRIP_INSERT_INSTR;
    if (cls == IRRIP_TRANSL) return IRRIP_INSERT_TRANSL;
    return IRRIP_INSERT_DATA;
}

static inline uint8_t irrip_promote_rrpv(int cls)
{
    if (cls == IRRIP_INSTR)  return IRRIP_PROMOTE_INSTR;
    if (cls == IRRIP_TRANSL) return IRRIP_PROMOTE_TRANSL;
    return IRRIP_PROMOTE_DATA;
}

void CACHE::l2c_initialize_replacement()
{
    /* Every way starts at the edge, which is also why find_victim needs no
     * invalid-line check: an untouched way already reads as "evict me". */
    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            l2_irrip_rrpv[i][j] = IRRIP_MAX_RRPV;

    for (int c = 0; c < 3; c++) { irrip_insert[c] = 0; irrip_promote[c] = 0; }
    irrip_wb_skipped = irrip_evict_pref = irrip_age_rounds = 0;

    /* Every run's log is self-describing, and the sweep reads this line back
     * rather than trusting a filename -- the check that caught a stale binary
     * reporting a different I-RRIP's numbers as ours. */
    cout << NAME << " I-RRIP config"
         << "  MAX_RRPV " << IRRIP_MAX_RRPV
         << " | INSERT instr " << IRRIP_INSERT_INSTR
         << " data " << IRRIP_INSERT_DATA
         << " transl " << IRRIP_INSERT_TRANSL
         << " | PROMOTE instr " << IRRIP_PROMOTE_INSTR
         << " data " << IRRIP_PROMOTE_DATA
         << " transl " << IRRIP_PROMOTE_TRANSL
         << " | EVICT_PREFER_DATA " << IRRIP_EVICT_PREFER_DATA
         << " slack " << IRRIP_EVICT_SLACK
         << " | WB_PROMOTES " << IRRIP_WB_PROMOTES
         << endl;
}

/* Victim selection. The two loops below are plain RRIP, unchanged: take anyone
 * at the edge, else age the whole set and look again. Aging moves protected
 * lines too, so protection is a longer deadline and never an exemption --
 * which is what makes insertion-based prioritisation unable to starve data. */
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    while (1)
    {
#if IRRIP_EVICT_PREFER_DATA
        /* Compiled out by default. block.instruction is already maintained for
         * the L2C, so this costs no extra state; an invalid way reads as 0 and
         * is preferred here too, which is what we want. */
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_irrip_rrpv[set][i] + IRRIP_EVICT_SLACK >= IRRIP_MAX_RRPV
                && current_set[i].instruction == 0)
            { irrip_evict_pref++; return i; }
#endif
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_irrip_rrpv[set][i] == IRRIP_MAX_RRPV)
                return i;

        for (int i = 0; i < L2C_WAY; i++)
            l2_irrip_rrpv[set][i]++;
        irrip_age_rounds++;
    }
    assert(0);
    return 0;
}

/* Called for both insertion (hit == 0, a line is being filled) and promotion
 * (hit == 1, a resident line was referenced).
 *
 * isInstruction is the parameter Task 2a had to add, and insertion is why: in
 * handle_fill the order is find_victim (cache.cc:56) -> this function (527) ->
 * fill_cache (553), and fill_cache is what writes block[set][way].instruction.
 * So at insertion the block array still describes the line being EVICTED. The
 * incoming line's class can only arrive as an argument -- which is exactly
 * what "I-RRIP won't build until you finish this step" means. */
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)   /* a writeback carries no IP */
        assert(0);

    int cls = irrip_class(type, isInstruction);

    if (hit)
    {
        if (type == WRITEBACK && !IRRIP_WB_PROMOTES) { irrip_wb_skipped++; return; }
        l2_irrip_rrpv[set][way] = irrip_promote_rrpv(cls);
        irrip_promote[cls]++;
    }
    else
    {
        l2_irrip_rrpv[set][way] = irrip_insert_rrpv(cls);
        irrip_insert[cls]++;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    /* Smallest field holding 0..IRRIP_MAX_RRPV, computed rather than hard-coded
     * so the storage deliverable is right for whatever the sweep compiled. */
    int rrpv_bits = 1;
    while ((1 << rrpv_bits) - 1 < IRRIP_MAX_RRPV) rrpv_bits++;

    long rrpv_total = (long)L2C_SET * L2C_WAY * rrpv_bits;
    /* The type bit is charged only when the policy READS it, i.e. when the
     * eviction preference is on. Insertion and promotion take the class from
     * the packet, which is in flight anyway and is not state the cache keeps --
     * so instruction-consciousness itself costs 0 bits. */
    long type_total = IRRIP_EVICT_PREFER_DATA ? (long)L2C_SET * L2C_WAY : 0;

    cout << NAME << " IRRIP INSERTS instr " << irrip_insert[IRRIP_INSTR]
         << " data " << irrip_insert[IRRIP_DATA]
         << " transl " << irrip_insert[IRRIP_TRANSL] << endl;
    cout << NAME << " IRRIP PROMOTES instr " << irrip_promote[IRRIP_INSTR]
         << " data " << irrip_promote[IRRIP_DATA]
         << " transl " << irrip_promote[IRRIP_TRANSL] << endl;
    cout << NAME << " IRRIP WB SKIPPED " << irrip_wb_skipped << endl;
    cout << NAME << " IRRIP EVICT PREF FIRED " << irrip_evict_pref << endl;
    cout << NAME << " IRRIP AGE ROUNDS " << irrip_age_rounds << endl;
    cout << NAME << " IRRIP STORAGE rrpv_bits_per_line " << rrpv_bits
         << " rrpv_bits " << rrpv_total
         << " type_bits " << type_total
         << " total_bits " << (rrpv_total + type_total)
         << " total_bytes " << ((rrpv_total + type_total) / 8) << endl;
}
