#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

uint64_t irrip_instr_inserts = 0;
uint64_t irrip_data_inserts = 0;
uint64_t irrip_instr_hits = 0;
uint64_t irrip_data_hits = 0;
uint64_t irrip_instr_victims = 0;
uint64_t irrip_data_victims = 0;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP state for L2C" << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // First, fill any invalid line
    for (int i=0; i<L2C_WAY; i++) {
        if (!current_set[i].valid) {
            return i;
        }
    }

    // Look for maxRRPV line, prioritizing non-instruction (data) lines over instruction lines
    while (1)
    {
        // Check for a non-instruction line with maxRRPV
        for (int i=0; i<L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV && current_set[i].instruction == 0) {
                irrip_data_victims++;
                return i;
            }
        }

        // If no non-instruction line with maxRRPV exists, evict an instruction line with maxRRPV
        for (int i=0; i<L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV) {
                irrip_instr_victims++;
                return i;
            }
        }

        // Increment RRPV for all ways in the set until at least one reaches maxRRPV
        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t is_instruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
        TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
        TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
        TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // Promotion: promote to MRU (RRPV = 0) on any hit
    if (hit) {
        l2_rrpv[set][way] = 0;
        if (is_instruction)
            irrip_instr_hits++;
        else
            irrip_data_hits++;
    }
    // Insertion: prioritize instruction lines with RRPV = 1; data lines inserted with RRPV = 2 (maxRRPV - 1)
    else {
        if (is_instruction) {
            l2_rrpv[set][way] = 1;
            irrip_instr_inserts++;
        } else {
            l2_rrpv[set][way] = maxRRPV - 1; // 2
            irrip_data_inserts++;
        }
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "=== I-RRIP Stats ===" << endl;
    cout << "Instruction Inserts: " << irrip_instr_inserts << endl;
    cout << "Data Inserts:        " << irrip_data_inserts << endl;
    cout << "Instruction Hits:    " << irrip_instr_hits << endl;
    cout << "Data Hits:           " << irrip_data_hits << endl;
    cout << "Instruction Victims: " << irrip_instr_victims << endl;
    cout << "Data Victims:        " << irrip_data_victims << endl;
}
