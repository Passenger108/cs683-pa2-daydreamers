#include "cache.h"

/* ---------------- Parameters ---------------- */
#define DYN_MAX_RRPV     3      // 2-bit RRPV: 0 (keep) .. 3 (evict)
#define DYN_NUM_LEADERS  8      // leader sets per policy
#define DYN_WINDOW       8192   // re-decide the mode every 8192 L2 loads
#define DYN_INSTR_WEIGHT 2      // an instruction miss counts double in PSEL
#define DYN_PF_INSERT    DYN_MAX_RRPV  // Task 3: RRPV given to a prefetched fill

#define DYN_PSEL_MAX  1023      // 10-bit saturating counter
#define DYN_PSEL_MID  512       // 512 = no preference

#define DYN_MODE_RRIP  0
#define DYN_MODE_IRRIP 1

#define DYN_TRANSL 0
#define DYN_INSTR  1
#define DYN_DATA   2

#define DYN_STRIDE     (L2C_SET / DYN_NUM_LEADERS)   // 1024 / 8 = 128
#define DYN_FOLLOWER   0
#define DYN_LEAD_RRIP  1
#define DYN_LEAD_IRRIP 2

/* ---------------- State ---------------- */
uint8_t  dyn_rrpv[L2C_SET][L2C_WAY];   // RRPV of every L2 line
uint8_t  dyn_mode;                     // mode the follower sets use now
uint32_t dyn_psel;                     // set-dueling score counter
uint64_t dyn_ctr;                      // L2 loads seen in the current window

/* In every block of 128 sets: set 0 always runs I-RRIP, set 64 always runs RRIP. */
static inline int dyn_role(uint32_t set)
{
    uint32_t r = set % DYN_STRIDE;
    if (r == 0)              return DYN_LEAD_IRRIP;
    if (r == DYN_STRIDE / 2) return DYN_LEAD_RRIP;
    return DYN_FOLLOWER;
}

/* Leaders keep their fixed policy; followers use the current winner. */
static inline int dyn_mode_of(uint32_t set)
{
    int r = dyn_role(set);
    if (r == DYN_LEAD_RRIP)  return DYN_MODE_RRIP;
    if (r == DYN_LEAD_IRRIP) return DYN_MODE_IRRIP;
    return dyn_mode;
}

/* Translation, instruction or data line. */
static inline int dyn_class(uint32_t type, uint8_t isInstruction)
{
    if (type == LOAD_TRANSLATION || type == PREFETCH_TRANSLATION || type == TRANSLATION_FROM_L1D)
        return DYN_TRANSL;
    if ((type == LOAD || type == PREFETCH) && isInstruction)
        return DYN_INSTR;
    return DYN_DATA;
}

/* Insertion: RRIP puts every new line at 2; I-RRIP puts instructions at 0, the rest at 3. */
static inline uint8_t dyn_insert_rrpv(int mode, int cls, int pf)
{
    if (pf) return DYN_PF_INSERT;   // Task 3: a prefetched line is not protected until a demand uses it
    if (mode == DYN_MODE_RRIP) return DYN_MAX_RRPV - 1;
    return (cls == DYN_INSTR) ? 0 : DYN_MAX_RRPV;
}

/* Promotion: RRIP moves any hit to 0; I-RRIP moves only instruction hits to 0. */
static inline uint8_t dyn_promote_rrpv(int mode, int cls)
{
    if (mode == DYN_MODE_RRIP) return 0;
    return (cls == DYN_INSTR) ? 0 : DYN_MAX_RRPV;
}

/* End of a window: low PSEL means I-RRIP leaders missed less, so followers use I-RRIP. */
static void dyn_end_of_window(void)
{
    dyn_mode = (dyn_psel < DYN_PSEL_MID) ? DYN_MODE_IRRIP : DYN_MODE_RRIP;

    /* Pull PSEL halfway back to the middle so old phases fade out. */
    dyn_psel = (uint32_t)((int)DYN_PSEL_MID + ((int)dyn_psel - (int)DYN_PSEL_MID) / 2);
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C" << endl;

    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            dyn_rrpv[i][j] = DYN_MAX_RRPV;   // empty cache: every way evictable

    dyn_mode = DYN_MODE_RRIP;   // start with plain RRIP until there is evidence
    dyn_psel = DYN_PSEL_MID;
    dyn_ctr  = 0;
}

/* Eviction: unchanged RRIP search. Take a line at max RRPV, else age the set and retry. */
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    while (1)
    {
        for (int i = 0; i < L2C_WAY; i++)
            if (dyn_rrpv[set][i] == DYN_MAX_RRPV)
                return i;
        for (int i = 0; i < L2C_WAY; i++)
            dyn_rrpv[set][i]++;
    }
    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    int cls  = dyn_class(type, isInstruction);
    int role = dyn_role(set);
    int mode = dyn_mode_of(set);
    int pf   = (type == PREFETCH);

    /* Set dueling: only demand loads are scored. */
    if (type == LOAD)
    {
        if (!hit)
        {
            int w = (cls == DYN_INSTR) ? DYN_INSTR_WEIGHT : 1;
            int d = 0;
            if (role == DYN_LEAD_IRRIP) d = +w;   // I-RRIP leader missed
            if (role == DYN_LEAD_RRIP)  d = -w;   // RRIP leader missed
            int v = (int)dyn_psel + d;
            if (v < 0) v = 0;
            if (v > (int)DYN_PSEL_MAX) v = DYN_PSEL_MAX;
            dyn_psel = (uint32_t)v;
        }

        if (++dyn_ctr >= DYN_WINDOW) { dyn_end_of_window(); dyn_ctr = 0; }
    }

    if (hit)
        dyn_rrpv[set][way] = dyn_promote_rrpv(mode, cls);       // promotion
    else
        dyn_rrpv[set][way] = dyn_insert_rrpv(mode, cls, pf);    // insertion
}

void CACHE::l2c_replacement_final_stats()
{

}
